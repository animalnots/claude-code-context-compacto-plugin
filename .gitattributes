# Shell scripts must stay LF on every platform: bash on Linux and WSL rejects a CRLF script
# ("$'\r': command not found"), and core.autocrlf=true, the Windows default, checks them out CRLF.
*.sh  text eol=lf

# PowerShell accepts either line ending; LF keeps the copies users install identical to the repo.
*.ps1 text eol=lf
